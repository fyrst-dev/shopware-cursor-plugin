{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "./hooks/scripts/session-start.sh",
        "timeout": 5
      }
    ],
    "beforeShellExecution": [
      {
        "command": "./hooks/scripts/check-php-tools.sh",
        "timeout": 5
      },
      {
        "command": "./hooks/scripts/check-js-admin-tools.sh",
        "timeout": 5
      },
      {
        "command": "./hooks/scripts/check-js-storefront-tools.sh",
        "timeout": 5
      },
      {
        "command": "./hooks/scripts/worktree-directives.sh",
        "timeout": 5
      }
    ],
    "postToolUse": [
      {
        "command": "./hooks/scripts/check-phpstan-baseline.sh",
        "timeout": 5,
        "matcher": "phpstan_analyze"
      },
      {
        "command": "./hooks/scripts/worktree-directives.sh",
        "timeout": 5
      }
    ]
  }
}
